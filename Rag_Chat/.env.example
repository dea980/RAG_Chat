# =====================================================
# Triple Chat - Environment Variables Template
# Copy to `.env` (at Rag_Chat/) and fill in real values.
# docker-compose reads this file automatically.
# =====================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---- PostgreSQL ----
POSTGRES_DB=triple_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Session ----
# Aligned: Redis TTL ↔ DB User.expired_datetime use the same window (seconds)
SESSION_TIMEOUT=300

# ---- LLM Providers ----
# Set provider per role; default is Gemini for all three.
EMBEDDING_PROVIDER=gemini
REASONING_PROVIDER=gemini
GENERATION_PROVIDER=gemini

# Gemini (required when *_PROVIDER=gemini)
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
GOOGLE_CHAT_MODEL=gemini-1.5-flash

# Qwen (optional, only when *_PROVIDER=qwen — OpenAI-compatible endpoint)
# QWEN_API_KEY=your-qwen-api-key
# QWEN_API_BASE=https://api.example.com/v1
# QWEN_MODEL_NAME=qwen-plus
# QWEN_REASONING_MODEL=qwen-plus
# QWEN_GENERATION_MODEL=qwen-plus
